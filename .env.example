# Copy this file to .env and fill in your values.
# Never commit a real .env file.

OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Local PostgreSQL values for docker-compose.yml. Replace both placeholders.
POSTGRES_USER=replace_with_local_username
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=leadpilot
DATABASE_URL=postgresql://replace_with_local_username:replace_with_local_password@localhost:5432/leadpilot
